---
// Features & Capabilities — flanked 3-center-3 layout
---
<section class="features-section" id="capacidades">
  <div class="container">

    <div class="section-header">
      <span class="section-tag" data-i18n="featuresTag">Nuestras Capacidades</span>
      <h2 class="section-title" data-i18n="featuresTitle">Soluciones de ingeniería digital de punta a punta</h2>
      <div class="section-divider">
        <span class="line"></span>
        <span class="dot"></span>
        <span class="line"></span>
      </div>
      <p class="section-sub" data-i18n="featuresSub">
        Tecnologías modernas implementadas con estándares internacionales de desarrollo.
      </p>
    </div>

    <div class="features-flanked-layout">

      <!-- Left 3 features -->
      <div class="features-col left-col">
        <div class="feat-item">
          <div class="feat-icon-badge">
            <svg class="icon" viewBox="0 0 24 24">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <div class="feat-info">
            <h4 class="feat-title" data-i18n="feat1Title">Plataformas Web y SaaS</h4>
            <p class="feat-desc" data-i18n="feat1Desc">Sistemas web interactivos construidos con React, Next.js y APIs REST/GraphQL de baja latencia.</p>
          </div>
        </div>

        <div class="feat-item">
          <div class="feat-icon-badge">
            <svg class="icon" viewBox="0 0 24 24">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
            </svg>
          </div>
          <div class="feat-info">
            <h4 class="feat-title" data-i18n="feat2Title">Aplicaciones Móviles</h4>
            <p class="feat-desc" data-i18n="feat2Desc">Desarrollo nativo e híbrido para iOS y Android con experiencias fluidas y sincronización offline.</p>
          </div>
        </div>

        <div class="feat-item">
          <div class="feat-icon-badge">
            <svg class="icon" viewBox="0 0 24 24">
              <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
              <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
              <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
            </svg>
          </div>
          <div class="feat-info">
            <h4 class="feat-title" data-i18n="feat3Title">Ingeniería de Datos</h4>
            <p class="feat-desc" data-i18n="feat3Desc">Pipelines ETL, lagos de datos y modelado analítico para la toma de decisiones basada en métricas.</p>
          </div>
        </div>
      </div>

      <!-- Center device mockup -->
      <div class="features-center-device">
        <div class="center-device-frame">
          <div class="center-device-screen">
            <div class="phone-screen-card">
              <div class="phone-screen-card-header">
                <span>MSS Core System</span>
                <span style="color:#10b981;">Online</span>
              </div>
              <div style="font-size:0.95rem;font-weight:700;color:#181c2e;">Active Sprints</div>
              <div style="font-size:0.75rem;color:#64748b;">4 modules in CI/CD pipeline</div>
              <div class="phone-screen-progress">
                <div class="phone-screen-progress-bar"></div>
              </div>
            </div>
            <div class="phone-screen-card">
              <div class="phone-screen-card-header">
                <span>Microservices Status</span>
                <span>99.98%</span>
              </div>
              <div style="display:flex;gap:8px;margin-top:6px;">
                <span style="font-size:0.7rem;background:#ede9fe;color:#6d28d9;padding:2px 8px;border-radius:4px;font-weight:600;">Auth API</span>
                <span style="font-size:0.7rem;background:#ecfdf5;color:#047857;padding:2px 8px;border-radius:4px;font-weight:600;">Data Lake</span>
              </div>
            </div>
            <div class="phone-screen-card">
              <div style="font-size:0.75rem;font-weight:700;color:#181c2e;margin-bottom:4px;">Security Audit</div>
              <div style="font-size:0.72rem;color:#64748b;">Zero vulnerabilities detected in static code analysis.</div>
              <div class="phone-screen-btn">System Healthy</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right 3 features -->
      <div class="features-col right-col">
        <div class="feat-item">
          <div class="feat-icon-badge">
            <svg class="icon" viewBox="0 0 24 24">
              <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
            </svg>
          </div>
          <div class="feat-info">
            <h4 class="feat-title" data-i18n="feat4Title">Arquitectura Cloud y DevOps</h4>
            <p class="feat-desc" data-i18n="feat4Desc">Infraestructuras en AWS, Google Cloud y Azure con despliegue automatizado y contenedores Docker.</p>
          </div>
        </div>

        <div class="feat-item">
          <div class="feat-icon-badge">
            <svg class="icon" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="4"></circle>
              <line x1="4.93" y1="4.93" x2="9.17" y2="9.17"></line>
              <line x1="14.83" y1="14.83" x2="19.07" y2="19.07"></line>
              <line x1="14.83" y1="9.17" x2="19.07" y2="4.93"></line>
            </svg>
          </div>
          <div class="feat-info">
            <h4 class="feat-title" data-i18n="feat5Title">Diseño UI/UX de Producto</h4>
            <p class="feat-desc" data-i18n="feat5Desc">Prototipado interactivo, sistemas de diseño estandarizados e interfaces intuitivas centradas en el usuario.</p>
          </div>
        </div>

        <div class="feat-item">
          <div class="feat-icon-badge">
            <svg class="icon" viewBox="0 0 24 24">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <div class="feat-info">
            <h4 class="feat-title" data-i18n="feat6Title">Seguridad y Auditoría</h4>
            <p class="feat-desc" data-i18n="feat6Desc">Cumplimiento normativo, pruebas de penetración, cifrado integral y prevención activa de vulnerabilidades.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

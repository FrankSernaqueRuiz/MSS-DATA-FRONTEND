---
// Contact / Quote Request Section
import { WEB3FORMS_KEY, NOTIFY_EMAILS, PUBLIC_EMAIL, WHATSAPP_CONTACTS } from '../config/contact.js';
---
<section class="contact-section" id="contacto">
  <div class="container">

    <div class="contact-card-box">

      <div class="contact-sidebar">
        <div class="contact-sidebar-top">
          <span class="section-tag" style="background:rgba(255,255,255,0.15);color:#fff;" data-i18n="contactTag">Inicia Tu Proyecto</span>
          <h3 data-i18n="contactTitle">Hablemos de tus requerimientos técnicos</h3>
          <p data-i18n="contactSub">Completa el formulario y recibe una propuesta de arquitectura y cronograma estimado en menos de 24 horas.</p>
          <div class="contact-details-list">
            <div class="contact-detail-row">
              <div class="contact-detail-icon">
                <svg class="icon" viewBox="0 0 24 24">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <a href={`mailto:${PUBLIC_EMAIL}`} style="color: inherit; text-decoration: none;">{PUBLIC_EMAIL}</a>
            </div>
            <div class="contact-detail-row">
              <div class="contact-detail-icon">
                <svg class="icon" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
              </div>
              <span>Atención Global Remota</span>
            </div>
            <div class="contact-detail-row">
              <div class="contact-detail-icon">
                <svg class="icon" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <span>Tiempo de respuesta: &lt; 24h</span>
            </div>
          </div>
        </div>
        <div style="font-size:0.8rem;color:rgba(255,255,255,0.7);margin-top:30px;">MSS-DATA Engineering Systems</div>
      </div>

      <div class="contact-form-pane">
        <form
          class="contact-form"
          id="contactForm"
          method="POST"
          action="https://api.web3forms.com/submit"
          data-web3forms-key={WEB3FORMS_KEY}
          data-fallback-email={PUBLIC_EMAIL}
          data-whatsapp={JSON.stringify(WHATSAPP_CONTACTS)}
        >
          <!-- Web3Forms: enrutamiento del correo. Sin clave, main.js usa mailto. -->
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input type="hidden" name="subject" value="Nueva solicitud de cotización — mssdataperu.com" />
          <input type="hidden" name="from_name" value="Web MSS-DATA" />
          <input type="hidden" name="cc" value={NOTIFY_EMAILS.join(',')} />
          <input type="hidden" name="origen" id="formOrigin" value="Formulario web" />

          <!-- Honeypot anti-spam: invisible para personas, irresistible para bots. -->
          <input
            type="checkbox"
            name="botcheck"
            class="form-honeypot"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label" for="fieldName" data-i18n="formNameLabel">Nombre Completo</label>
              <input type="text" id="fieldName" name="nombre" class="form-input" required
                autocomplete="name"
                placeholder="Ej. Carlos Mendoza"
                data-i18n-placeholder="formNamePlaceholder" />
            </div>
            <div class="form-group">
              <label class="form-label" for="fieldEmail" data-i18n="formEmailLabel">Correo Corporativo</label>
              <input type="email" id="fieldEmail" name="email" class="form-input" required
                autocomplete="email"
                placeholder="carlos@empresa.com"
                data-i18n-placeholder="formEmailPlaceholder" />
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label" for="fieldPhone" data-i18n="formPhoneLabel">Teléfono / WhatsApp</label>
              <input type="tel" id="fieldPhone" name="telefono" class="form-input"
                autocomplete="tel"
                placeholder="+51 999 999 999"
                data-i18n-placeholder="formPhonePlaceholder" />
            </div>
            <div class="form-group">
              <label class="form-label" for="fieldCompany" data-i18n="formCompanyLabel">Empresa</label>
              <input type="text" id="fieldCompany" name="empresa" class="form-input"
                autocomplete="organization"
                placeholder="Nombre de tu organización"
                data-i18n-placeholder="formCompanyPlaceholder" />
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label" for="fieldService" data-i18n="formServiceLabel">Tipo de Proyecto</label>
              <select class="form-select" id="fieldService" name="tipo_proyecto">
                <option value="Desarrollo Web / Plataforma SaaS" data-i18n="formServiceOpt1">Desarrollo Web / Plataforma SaaS</option>
                <option value="Aplicación Móvil iOS / Android" data-i18n="formServiceOpt2">Aplicación Móvil iOS / Android</option>
                <option value="Ingeniería de Datos y Analítica" data-i18n="formServiceOpt3">Ingeniería de Datos y Analítica</option>
                <option value="Auditoría, Cloud o DevOps" data-i18n="formServiceOpt4">Auditoría, Cloud o DevOps</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="fieldBudget" data-i18n="formBudgetLabel">Presupuesto Estimado</label>
              <select class="form-select" id="fieldBudget" name="presupuesto">
                <option value="< $5,000 USD" data-i18n="formBudgetOpt1">Menos de $5,000 USD</option>
                <option value="$5,000 - $15,000 USD" data-i18n="formBudgetOpt2">$5,000 - $15,000 USD</option>
                <option value="$15,000 - $30,000 USD" data-i18n="formBudgetOpt3">$15,000 - $30,000 USD</option>
                <option value="> $30,000 USD" data-i18n="formBudgetOpt4">Más de $30,000 USD</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="fieldMessage" data-i18n="formMessageLabel">Detalles del Proyecto</label>
            <textarea class="form-textarea" id="fieldMessage" name="mensaje" required
              placeholder="Describe los objetivos principales, requerimientos clave y tiempos estimados..."
              data-i18n-placeholder="formMessagePlaceholder"></textarea>
          </div>

          <!-- Consentimiento expreso — Ley 29733 de Protección de Datos Personales (Perú) -->
          <label class="form-consent" for="fieldConsent">
            <input type="checkbox" id="fieldConsent" name="consentimiento" value="Sí" required />
            <span data-i18n="formConsent">Autorizo a MSS-DATA a usar mis datos para responder esta consulta.</span>
          </label>

          <div class="form-actions">
            <button type="submit" class="btn-form-submit">
              <span class="btn-label" data-i18n="formSubmit">Solicitar Cotización Técnica</span>
              <span class="btn-spinner" aria-hidden="true"></span>
              <svg class="icon btn-icon" viewBox="0 0 24 24">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>

            <button type="button" class="btn-form-whatsapp" id="formWhatsappBtn">
              <svg class="icon" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.13-.42-2.15-1.33-.8-.71-1.34-1.59-1.49-1.89-.15-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.68-1.62-.93-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.46 0 1.45 1.06 2.85 1.21 3.05.15.2 2.09 3.2 5.07 4.37.71.3 1.26.48 1.69.62.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.12-.27-.2-.57-.35z"></path>
                <path d="M12.04 2.01c-5.52 0-10 4.48-10 10 0 1.76.46 3.41 1.26 4.85L2 22.01l5.3-1.38a9.93 9.93 0 0 0 4.74 1.2c5.52 0 10-4.48 10-10s-4.48-9.82-10-9.82zm0 18.2c-1.56 0-3.02-.44-4.25-1.21l-.3-.18-3.14.82.84-3.06-.2-.31a8.17 8.17 0 0 1-1.26-4.36c0-4.52 3.68-8.2 8.21-8.2 4.53 0 8.2 3.68 8.2 8.2 0 4.53-3.67 8.3-8.2 8.3z"></path>
              </svg>
              <span data-i18n="formWhatsapp">Enviarlo por WhatsApp</span>
            </button>
          </div>

          <p class="form-privacy-note" data-i18n="formPrivacyNote">
            Respondemos en menos de 24 horas hábiles. No compartimos tus datos con terceros.
          </p>

          <div class="form-alert-msg" id="formAlert" role="status" aria-live="polite">
            <svg class="icon" viewBox="0 0 24 24">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span data-i18n="formSuccess">Mensaje recibido exitosamente. Un ingeniero de MSS-DATA se comunicará contigo a la brevedad.</span>
          </div>

          <div class="form-alert-msg form-alert-error" id="formError" role="alert">
            <svg class="icon" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span data-i18n="formErrorMsg">No pudimos enviar el mensaje. Escríbenos por WhatsApp o a contacto@mssdataperu.com.</span>
          </div>

        </form>
      </div>

    </div>
  </div>
</section>

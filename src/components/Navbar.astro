---
// Navbar Component — no props needed, all text via data-i18n
---
<div class="navbar-wrapper" id="navbarWrapper">
  <div class="container">
    <nav class="navbar">
      <a href="#hero" class="brand">
        <div class="brand-icon">
          <svg class="icon" viewBox="0 0 24 24">
            <path d="M16 18l6-6-6-6"></path>
            <path d="M8 6l-6 6 6 6"></path>
            <line x1="12" y1="4" x2="12" y2="20"></line>
          </svg>
        </div>
        <div class="brand-text">
          <span>MSS</span><span>-DATA</span>
          <span class="brand-badge">TECH</span>
        </div>
      </a>

      <ul class="nav-menu" id="navMenu">
        <li><a href="#hero" class="nav-link active" data-i18n="navHome">Inicio</a></li>
        <li><a href="#servicios" class="nav-link" data-i18n="navServices">Servicios</a></li>
        <li><a href="#nosotros" class="nav-link" data-i18n="navAbout">Nosotros</a></li>
        <li><a href="#capacidades" class="nav-link" data-i18n="navFeatures">Capacidades</a></li>
        <li><a href="#proyectos" class="nav-link" data-i18n="navProjects">Proyectos</a></li>
        <li><a href="#contacto" class="nav-link" data-i18n="navContact">Contacto</a></li>
      </ul>

      <div class="nav-actions">
        <button class="btn-lang-trigger" id="langTriggerBtn" aria-label="Cambiar Idioma">
          <svg class="icon" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span class="lang-flag-label" id="currentLangLabel">ES</span>
          <svg class="icon" style="width: 14px; height: 14px;" viewBox="0 0 24 24">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <a href="#contacto" class="btn-cta" data-i18n="navCta">Cotizar Proyecto</a>

        <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Menu">
          <svg class="icon" style="width: 26px; height: 26px;" viewBox="0 0 24 24">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</div>

---
// Projects / Case Studies Component
---
<section class="projects-section" id="proyectos">
  <div class="container">

    <div class="section-header">
      <span class="section-tag" data-i18n="projectsTag">Casos de Éxito</span>
      <h2 class="section-title" data-i18n="projectsTitle">Proyectos construidos con precisión técnica</h2>
      <div class="section-divider">
        <span class="line"></span>
        <span class="dot"></span>
        <span class="line"></span>
      </div>
      <p class="section-sub" data-i18n="projectsSub">
        Una muestra representativa de los productos que hemos llevado a producción.
      </p>
    </div>

    <div class="projects-grid">

      <!-- Project 1: Fintech -->
      <div class="project-card">
        <div class="project-banner">
          <div class="project-banner-visual">
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="font-family:var(--font-mono);font-size:0.7rem;color:#a5b4fc;">FINTECH-ENGINE-01</span>
              <span style="background:rgba(99,102,241,0.3);color:#c7d2fe;font-size:0.65rem;padding:2px 8px;border-radius:4px;">Live API</span>
            </div>
            <div style="font-family:var(--font-mono);font-size:1.1rem;color:#fff;font-weight:700;">$1.2M+ / mes</div>
            <div style="font-size:0.7rem;color:#94a3b8;">99.99% Transacciones Conciliadas</div>
          </div>
        </div>
        <div class="project-body">
          <span class="project-cat" data-i18n="project1Category">Fintech &amp; Facturación</span>
          <h3 class="project-title" data-i18n="project1Title">Plataforma de Facturación y Conciliación Automatizada</h3>
          <p class="project-desc" data-i18n="project1Desc">Sistema en tiempo real para procesamiento masivo de transacciones bancarias, generación de facturas electrónicas y auditoría fiscal.</p>
          <div class="project-tags">
            <span class="project-tag-pill">Next.js</span>
            <span class="project-tag-pill">PostgreSQL</span>
            <span class="project-tag-pill">Redis</span>
            <span class="project-tag-pill">Stripe API</span>
          </div>
        </div>
      </div>

      <!-- Project 2: Logistics -->
      <div class="project-card">
        <div class="project-banner">
          <div class="project-banner-visual">
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="font-family:var(--font-mono);font-size:0.7rem;color:#6ee7b7;">TELEMETRY-HUB-02</span>
              <span style="background:rgba(16,185,129,0.3);color:#a7f3d0;font-size:0.65rem;padding:2px 8px;border-radius:4px;">IoT Active</span>
            </div>
            <div style="font-family:var(--font-mono);font-size:1.1rem;color:#fff;font-weight:700;">+450 Unidades</div>
            <div style="font-size:0.7rem;color:#94a3b8;">Monitoreo GPS en tiempo real</div>
          </div>
        </div>
        <div class="project-body">
          <span class="project-cat" data-i18n="project2Category">Logística &amp; Supply Chain</span>
          <h3 class="project-title" data-i18n="project2Title">Suite de Seguimiento y Gestión de Flotas</h3>
          <p class="project-desc" data-i18n="project2Desc">Panel de control georreferenciado con telemetría en vivo, optimización de rutas y algoritmos predictivos de entrega.</p>
          <div class="project-tags">
            <span class="project-tag-pill">React Native</span>
            <span class="project-tag-pill">Node.js</span>
            <span class="project-tag-pill">WebSockets</span>
            <span class="project-tag-pill">Mapbox</span>
          </div>
        </div>
      </div>

      <!-- Project 3: Healthcare -->
      <div class="project-card">
        <div class="project-banner">
          <div class="project-banner-visual">
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="font-family:var(--font-mono);font-size:0.7rem;color:#cbd5e1;">HEALTH-CORE-03</span>
              <span style="background:rgba(148,163,184,0.3);color:#f1f5f9;font-size:0.65rem;padding:2px 8px;border-radius:4px;">HIPAA Ready</span>
            </div>
            <div style="font-family:var(--font-mono);font-size:1.1rem;color:#fff;font-weight:700;">+120K Registros</div>
            <div style="font-size:0.7rem;color:#94a3b8;">Cifrado AES-256 de punta a punta</div>
          </div>
        </div>
        <div class="project-body">
          <span class="project-cat" data-i18n="project3Category">Salud &amp; Analítica</span>
          <h3 class="project-title" data-i18n="project3Title">Portal Clínico de Historiales y Métricas Médicas</h3>
          <p class="project-desc" data-i18n="project3Desc">Infraestructura protegida con encriptación de grado hospitalario para intercambio de datos clínicos y teleconsultas.</p>
          <div class="project-tags">
            <span class="project-tag-pill">Vue 3</span>
            <span class="project-tag-pill">FastAPI</span>
            <span class="project-tag-pill">Docker</span>
            <span class="project-tag-pill">AWS KMS</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

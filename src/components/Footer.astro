---
// Footer Component
---
<footer class="footer">
  <div class="container">

    <div class="footer-top-grid">

      <div class="footer-brand-pane">
        <div class="footer-brand">
          <div class="brand-icon">
            <svg class="icon" viewBox="0 0 24 24">
              <path d="M16 18l6-6-6-6"></path>
              <path d="M8 6l-6 6 6 6"></path>
              <line x1="12" y1="4" x2="12" y2="20"></line>
            </svg>
          </div>
          <span>MSS-DATA</span>
        </div>
        <p class="footer-desc" data-i18n="footerDesc">
          MSS-DATA es una empresa de desarrollo de software e ingeniería de datos dedicada a crear productos tecnológicos de alta demanda y escalabilidad.
        </p>
      </div>

      <div>
        <h4 class="footer-col-title" data-i18n="footerNavTitle">Navegación</h4>
        <ul class="footer-links-list">
          <li><a href="#hero" class="footer-link" data-i18n="navHome">Inicio</a></li>
          <li><a href="#servicios" class="footer-link" data-i18n="navServices">Servicios</a></li>
          <li><a href="#nosotros" class="footer-link" data-i18n="navAbout">Nosotros</a></li>
          <li><a href="#capacidades" class="footer-link" data-i18n="navFeatures">Capacidades</a></li>
          <li><a href="#proyectos" class="footer-link" data-i18n="navProjects">Proyectos</a></li>
        </ul>
      </div>

      <div>
        <h4 class="footer-col-title" data-i18n="footerServicesTitle">Especialidades</h4>
        <ul class="footer-links-list">
          <li><a href="#capacidades" class="footer-link">SaaS &amp; Cloud Native</a></li>
          <li><a href="#capacidades" class="footer-link">Mobile Apps iOS/Android</a></li>
          <li><a href="#capacidades" class="footer-link">Data Pipelines ETL</a></li>
          <li><a href="#capacidades" class="footer-link">DevOps &amp; CI/CD</a></li>
          <li><a href="#capacidades" class="footer-link">Auditoría de Código</a></li>
        </ul>
      </div>

      <div>
        <h4 class="footer-col-title" data-i18n="footerLegalTitle">Legal &amp; Seguridad</h4>
        <ul class="footer-links-list">
          <li><a href="#contacto" class="footer-link" data-i18n="footerPrivacy">Política de Privacidad</a></li>
          <li><a href="#contacto" class="footer-link" data-i18n="footerTerms">Términos del Servicio</a></li>
          <li><a href="#contacto" class="footer-link" data-i18n="footerSecurity">Seguridad de Datos</a></li>
          <li><a href="#contacto" class="footer-link">SLA &amp; Garantía</a></li>
        </ul>
      </div>

    </div>

    <div class="footer-bottom">
      <div>
        &copy; <span id="currentYear">2026</span>
        <span data-i18n="footerCopyright">MSS-DATA. Todos los derechos reservados. Desarrollado con excelencia técnica.</span>
      </div>
      <div>
        <button class="btn-lang-trigger" style="color:#cbd5e1;border-color:#334155;background:#1e293b;">
          <svg class="icon" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span data-i18n="langSelectorTitle">Seleccionar Idioma</span>
        </button>
      </div>
    </div>

  </div>
</footer>

<script>
  document.getElementById('currentYear').textContent = new Date().getFullYear().toString();
</script>

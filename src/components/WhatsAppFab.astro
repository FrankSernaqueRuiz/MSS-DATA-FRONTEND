---
// Botón flotante de WhatsApp con selector de socio.
// Reparte los leads entre los tres números de forma pareja (round-robin).
import { WHATSAPP_CONTACTS } from '../config/contact.js';
---
<div class="wa-fab-root" id="waFabRoot">

  <div class="wa-panel" id="waPanel" role="dialog" aria-modal="false" aria-labelledby="waPanelTitle">
    <div class="wa-panel-header">
      <div>
        <h4 class="wa-panel-title" id="waPanelTitle" data-i18n="waPanelTitle">Conversemos por WhatsApp</h4>
        <p class="wa-panel-sub" data-i18n="waPanelSub">Elige con quién hablar. Respuesta en minutos en horario laboral.</p>
      </div>
      <button class="wa-panel-close" id="waPanelClose" aria-label="Cerrar">
        <svg class="icon" viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <ul class="wa-contact-list">
      {WHATSAPP_CONTACTS.map((contact) => (
        <li>
          <a
            class="wa-contact-row"
            href={`https://wa.me/${contact.phone}`}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-phone={contact.phone}
          >
            <span class="wa-contact-avatar">{contact.name.charAt(0)}</span>
            <span class="wa-contact-info">
              <span class="wa-contact-name">{contact.name}</span>
              <span class="wa-contact-role" data-i18n="waContactRole">Equipo de Ingeniería</span>
            </span>
            <svg class="icon wa-contact-arrow" viewBox="0 0 24 24">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <p class="wa-panel-hours" id="waHours" data-i18n="waHours">Lun a Vie, 9:00 - 19:00 (GMT-5)</p>
  </div>

  <button class="wa-fab" id="waFabBtn" aria-label="Abrir WhatsApp" aria-expanded="false" aria-controls="waPanel">
    <svg class="wa-fab-icon" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
      <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.13-.42-2.15-1.33-.8-.71-1.34-1.59-1.49-1.89-.15-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.68-1.62-.93-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.46 0 1.45 1.06 2.85 1.21 3.05.15.2 2.09 3.2 5.07 4.37.71.3 1.26.48 1.69.62.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.12-.27-.2-.57-.35z"></path>
      <path d="M12.04 2.01c-5.52 0-10 4.48-10 10 0 1.76.46 3.41 1.26 4.85L2 22.01l5.3-1.38a9.93 9.93 0 0 0 4.74 1.2c5.52 0 10-4.48 10-10s-4.48-9.82-10-9.82zm0 18.2c-1.56 0-3.02-.44-4.25-1.21l-.3-.18-3.14.82.84-3.06-.2-.31a8.17 8.17 0 0 1-1.26-4.36c0-4.52 3.68-8.2 8.21-8.2 4.53 0 8.2 3.68 8.2 8.2 0 4.53-3.67 8.3-8.2 8.3z"></path>
    </svg>
    <span class="wa-fab-pulse" aria-hidden="true"></span>
  </button>

</div>

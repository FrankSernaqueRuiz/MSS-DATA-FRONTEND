---
// Tech Stack Band Component
---
<section class="tech-section">
  <div class="container">
    <h3 class="tech-title" data-i18n="techTitle">Ecosistema Tecnológico Moderno</h3>
    <div class="tech-badges-grid">
      <div class="tech-badge">
        <svg class="icon" style="color:#61dafb;" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="3"></circle>
          <ellipse cx="12" cy="12" rx="10" ry="4"></ellipse>
          <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"></ellipse>
          <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"></ellipse>
        </svg>
        <span>React &amp; Next.js</span>
      </div>
      <div class="tech-badge">
        <svg class="icon" style="color:#3178c6;" viewBox="0 0 24 24">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <span>TypeScript</span>
      </div>
      <div class="tech-badge">
        <svg class="icon" style="color:#22c55e;" viewBox="0 0 24 24">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
        <span>Node.js &amp; Python</span>
      </div>
      <div class="tech-badge">
        <svg class="icon" style="color:#336791;" viewBox="0 0 24 24">
          <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
          <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
          <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
        </svg>
        <span>PostgreSQL &amp; Redis</span>
      </div>
      <div class="tech-badge">
        <svg class="icon" style="color:#0284c7;" viewBox="0 0 24 24">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
        </svg>
        <span>Docker &amp; Kubernetes</span>
      </div>
      <div class="tech-badge">
        <svg class="icon" style="color:#f59e0b;" viewBox="0 0 24 24">
          <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
        </svg>
        <span>AWS &amp; Cloudflare</span>
      </div>
    </div>
  </div>
</section>
